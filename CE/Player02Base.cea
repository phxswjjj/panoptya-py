// 進入戰鬥前會從屬性面版取得屬性
define(address, "GameAssembly.dll"+5C1EDF)
define(bytes,8B 41 30 48 83 C4 20)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000, "GameAssembly.dll"+5C1EDF)

label(code)
label(return)

registersymbol(Player02Base)

newmem:
  // 如果 Player02Base 已经被找到过了，就直接跳过
  cmp [Player02Base],0
  jne code

  // HP>0
  cmp [rcx+30],0
  je code

  // id? 騎士=#5039, 薩滿=#2855, 戰士=#5588, 騎士2=#1245
  cmp [rcx+1c],#5588
  jne code

  mov [Player02Base],rcx

code:
  mov eax,[rcx+30]
  add rsp,20
  jmp return

Player02Base:
  dq 0

address:
  jmp newmem
  nop 2
return:

[DISABLE]

address:
  db bytes
  // mov eax,[rcx+30]
  // add rsp,20

dealloc(newmem)
unregistersymbol(Player02Base)

{
